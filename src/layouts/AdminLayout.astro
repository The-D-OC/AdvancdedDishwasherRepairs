---
import '@/styles/global.css';

import Icon from '@/components/ui/Icon.astro';
import { SITE } from '@/config/site';

interface Props {
  title: string;
  /** Hide the nav (login page). */
  bare?: boolean;
}

const { title, bare = false } = Astro.props;
const path = Astro.url.pathname;
const manualsActive = path.startsWith('/admin/manuals');
const machinesActive = !manualsActive && (path === '/admin' || path.startsWith('/admin/machines'));
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#060a13" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} | Admin | {SITE.name}</title>
  </head>
  <body class="admin">
    <a href="#main" class="skip-link">Skip to content</a>
    {
      !bare && (
        <header class="admin-bar">
          <div class="container admin-bar__inner">
            <a href="/admin" class="admin-bar__brand">
              <Icon name="bolt" size={18} /> ADR Admin
            </a>
            <nav aria-label="Admin">
              <a href="/admin" aria-current={machinesActive ? 'page' : undefined}>
                Machines
              </a>
              <a href="/admin/manuals" aria-current={manualsActive ? 'page' : undefined}>
                Manuals
              </a>
              <a href="/" target="_blank" rel="noopener">
                View site ↗
              </a>
            </nav>
            <form method="post" action="/admin/logout">
              <button type="submit" class="btn btn--ghost admin-bar__logout">Log out</button>
            </form>
          </div>
        </header>
      )
    }
    <main id="main" tabindex="-1" class="admin-main">
      <div class="container">
        <slot />
      </div>
    </main>
  </body>
</html>

<style is:global>
  body.admin {
    background: var(--bg);
  }
  .admin-bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--border);
  }
  .admin-bar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    min-height: 64px;
  }
  .admin-bar__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 800;
    color: var(--text);
    text-decoration: none;
  }
  .admin-bar nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .admin-bar nav a {
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    color: var(--text-2);
    font-weight: 600;
    font-size: var(--fs-sm);
    text-decoration: none;
  }
  .admin-bar nav a:hover,
  .admin-bar nav a[aria-current='page'] {
    color: var(--text);
    background: var(--surface-2);
  }
  .admin-bar form {
    margin-left: auto;
  }
  .admin-bar__logout {
    min-height: 40px;
  }
  .admin-main {
    padding-block: 2rem 4rem;
  }
  .admin-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .admin-head h1 {
    font-size: var(--fs-2xl);
  }
  .notice {
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.25rem;
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .notice--ok {
    border: 1px solid rgb(52 211 153 / 0.4);
    background: rgb(52 211 153 / 0.1);
    color: #a7f3d0;
  }
  .notice--error {
    border: 1px solid rgb(248 113 113 / 0.4);
    background: rgb(248 113 113 / 0.1);
    color: #fecaca;
  }
</style>
