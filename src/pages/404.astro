---
import Icon from '@/components/ui/Icon.astro';
import { SITE, telHref } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="Sorry, the page you were looking for could not be found." noindex>
  <section class="section">
    <div class="container nf">
      <p class="nf__code" aria-hidden="true">404</p>
      <h1>Page not found</h1>
      <p class="lead">Sorry, that page doesn’t exist or has moved. Try one of these instead:</p>
      <div class="nf__actions">
        <a href="/" class="btn btn--primary">Go to home</a>
        <a href="/fault-codes" class="btn btn--secondary">Fault codes</a>
        <a href="/for-sale" class="btn btn--secondary">Machines for sale</a>
        <a href={telHref} class="btn btn--ghost"><Icon name="phone" size={18} /> {SITE.phone.display}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1rem;
    padding-block: 2rem;
  }
  .nf__code {
    font-size: clamp(5rem, 3rem + 10vw, 9rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.05em;
    background: linear-gradient(180deg, var(--text), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  h1 {
    font-size: var(--fs-2xl);
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>
