---
import EnquiryForm from '@/components/forms/EnquiryForm.astro';
import MachineCard from '@/components/sale/MachineCard.astro';
import CtaBanner from '@/components/ui/CtaBanner.astro';
import Icon from '@/components/ui/Icon.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { SITE, mailtoHref, telHref } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CONDITION_LABEL } from '@/lib/format';
import { listPublicMachines } from '@/lib/machines';
import { publicClient } from '@/lib/supabase';
import { faqSchema, itemListSchema } from '@/lib/seo';
import type { MachineCondition } from '@/types/content';

// Rendered on each request so listings edited in /admin appear immediately.
export const prerender = false;

const sorted = await listPublicMachines(publicClient()); // available → reserved → sold
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
const forSale = sorted.filter((m) => m.status !== 'sold');
const conditions = (['new', 'refurbished', 'used'] as MachineCondition[]).filter((c) => sorted.some((m) => m.condition === c));
const types = [...new Set(sorted.map((m) => m.machineType))].sort();
const machineOptions = forSale.map((m) => `${m.title} (${m.reference})`);

const faqs = [
  {
    q: 'How do I buy a machine?',
    a: `Call us on ${SITE.phone.display}, email ${SITE.email}, or send an enquiry using the form on this page. We’ll confirm availability, answer any questions and arrange payment, delivery and installation.`,
  },
  {
    q: 'Are the machines tested?',
    a: 'Yes. Every used and refurbished machine is serviced and run through full wash and rinse cycles by our engineers before sale.',
  },
  {
    q: 'Do machines come with a warranty?',
    a: 'Warranty cover depends on the machine and is shown on each listing. New machines carry the manufacturer’s warranty.',
  },
  {
    q: 'Can you install it for me?',
    a: 'Yes — our engineers can install and commission any machine we sell. Tick “Need it installed?” on the enquiry form and we’ll include it in your quote.',
  },
  {
    q: 'Can’t see what you need?',
    a: 'Stock changes regularly. Tell us what you’re looking for and we’ll let you know when a suitable machine comes in.',
  },
];
---

<BaseLayout
  title="Commercial Dishwashers & Glasswashers For Sale"
  description="New, refurbished and used commercial dishwashers and glasswashers for sale. Tested by our engineers, with installation available. Call or email to enquire."
  breadcrumbs={[{ label: 'For Sale', href: '/for-sale' }]}
  jsonLd={[
    faqSchema(faqs),
    itemListSchema(
      'Commercial dishwashers for sale',
      forSale.map((m) => ({ name: m.title, path: `/for-sale/${m.slug}` })),
    ),
  ]}
>
  <PageHero
    eyebrow="Machines for sale"
    title="Commercial dishwashers & glasswashers for sale"
    lead="New, refurbished and used machines from leading brands — serviced and tested by our own engineers, ready to install."
    breadcrumbs={[{ label: 'For Sale', href: '/for-sale' }]}
  >
    <div class="sale-hero">
      <div class="sale-hero__actions">
        <a href={telHref} class="btn btn--primary btn--lg"><Icon name="phone" size={20} /> Call {SITE.phone.display}</a>
        <a href={mailtoHref('Machine for sale enquiry')} class="btn btn--secondary btn--lg"><Icon name="mail" size={20} /> Email us</a>
        <a href="#enquiry" class="btn btn--ghost btn--lg">Send an enquiry</a>
      </div>
      <ul class="sale-hero__trust">
        <li><Icon name="shield" size={18} /> Tested before sale</li>
        <li><Icon name="wrench" size={18} /> Installation available</li>
        <li><Icon name="truck" size={18} /> Delivery arranged</li>
        <li><Icon name="award" size={18} /> All leading brands</li>
      </ul>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="stock-title">
    <div class="container" data-sale-root>
      <div class="toolbar">
        <h2 id="stock-title" class="toolbar__title">
          Current stock <span class="toolbar__count" aria-live="polite" data-sale-count>{forSale.length} available</span>
        </h2>

        <div class="toolbar__controls">
          <div class="chips" role="group" aria-label="Filter by condition">
            <button type="button" class="chip" aria-pressed="true" data-condition="">All</button>
            {
              conditions.map((c) => (
                <button type="button" class="chip" aria-pressed="false" data-condition={c}>
                  {CONDITION_LABEL[c]}
                </button>
              ))
            }
          </div>
          <div class="toolbar__selects">
            <label class="sr-only" for="sale-type">Machine type</label>
            <select id="sale-type" class="select" data-sale-type>
              <option value="">All types</option>
              {types.map((t) => <option value={t}>{t}</option>)}
            </select>
            <label class="sr-only" for="sale-sort">Sort by</label>
            <select id="sale-sort" class="select" data-sale-sort>
              <option value="featured">Featured</option>
              <option value="price-asc">Price: low to high</option>
              <option value="price-desc">Price: high to low</option>
            </select>
          </div>
        </div>
      </div>

      <div class="grid grid--3" data-sale-grid>
        {sorted.map((m, i) => <MachineCard machine={m} eager={i < 3} />)}
      </div>

      <div class="empty card" data-sale-empty hidden={sorted.length > 0}>
        <h3>No machines match those filters</h3>
        <p>Stock changes often — tell us what you need and we’ll find it for you.</p>
        <a href="#enquiry" class="btn btn--primary">Tell us what you need</a>
      </div>
    </div>
  </section>

  <section id="enquiry" class="section section--alt" aria-labelledby="enquiry-title">
    <div class="container enquiry-layout">
      <div class="enquiry-layout__info">
        <p class="eyebrow">Enquire about a machine</p>
        <h2 id="enquiry-title" class="section-title">Speak to us about buying</h2>
        <p class="lead">Questions about a machine, delivery or installation? Get in touch however suits you.</p>

        <ul class="contact-methods">
          <li>
            <a href={telHref} class="contact-method">
              <span class="icon-tile"><Icon name="phone" size={22} /></span>
              <span>
                <small>Call or text</small>
                <strong>{SITE.phone.display}</strong>
              </span>
            </a>
          </li>
          <li>
            <a href={mailtoHref('Machine for sale enquiry')} class="contact-method">
              <span class="icon-tile"><Icon name="mail" size={22} /></span>
              <span>
                <small>Email</small>
                <strong class="break">{SITE.email}</strong>
              </span>
            </a>
          </li>
        </ul>

        <ol class="steps">
          <li><strong>Get in touch</strong> — call, email or send the form.</li>
          <li><strong>We confirm</strong> availability, price and any delivery or install.</li>
          <li><strong>Delivered &amp; working</strong> — installed by our engineers if you need.</li>
        </ol>
      </div>

      <div class="card enquiry-layout__form">
        <h3>Send an enquiry</h3>
        <EnquiryForm type="machine" machineOptions={machineOptions} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container faq">
      <div class="section-head">
        <p class="eyebrow">Buying FAQs</p>
        <h2 id="faq-title" class="section-title">Common questions</h2>
      </div>
      <div class="faq__list">
        {
          faqs.map((f) => (
            <details class="faq__item">
              <summary>
                {f.q}
                <Icon name="chevronDown" size={20} />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner title="Need a repair instead?" text="Our engineers fix all major brands — most faults on the first visit." />
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-sale-root]');
  if (root) {
    const grid = root.querySelector<HTMLElement>('[data-sale-grid]')!;
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-filter-item]')];
    const original = [...cards];
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-condition]')];
    const typeSelect = root.querySelector<HTMLSelectElement>('[data-sale-type]');
    const sortSelect = root.querySelector<HTMLSelectElement>('[data-sale-sort]');
    const count = root.querySelector<HTMLElement>('[data-sale-count]');
    const empty = root.querySelector<HTMLElement>('[data-sale-empty]');
    let condition = '';

    const apply = () => {
      const type = typeSelect?.value ?? '';
      const sort = sortSelect?.value ?? 'featured';
      let visible = 0;

      const ordered =
        sort === 'featured'
          ? original
          : [...original].sort((a, b) => {
              const diff = Number(a.dataset['price']) - Number(b.dataset['price']);
              return sort === 'price-asc' ? diff : -diff;
            });

      for (const card of ordered) {
        const match = (!condition || card.dataset['facet'] === condition) && (!type || card.dataset['type'] === type);
        card.hidden = !match;
        if (match && !card.classList.contains('machine--sold')) visible++;
        grid.append(card);
      }

      if (count) count.textContent = `${visible} available`;
      if (empty) empty.hidden = ordered.some((c) => !c.hidden);
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        condition = chip.dataset['condition'] ?? '';
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        apply();
      });
    }
    typeSelect?.addEventListener('change', apply);
    sortSelect?.addEventListener('change', apply);
  }
</script>

<style>
  .sale-hero {
    display: grid;
    gap: 1.5rem;
  }
  .sale-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .sale-hero__trust {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    color: var(--text-2);
    font-size: var(--fs-sm);
    font-weight: 600;
  }
  .sale-hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .sale-hero__trust :global(svg) {
    color: var(--accent);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .toolbar__title {
    font-size: var(--fs-xl);
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .toolbar__count {
    font-size: var(--fs-sm);
    color: var(--text-2);
    font-weight: 500;
    letter-spacing: 0;
  }
  .toolbar__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .toolbar__selects {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .toolbar__selects .select {
    width: auto;
    min-width: 11rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chip {
    min-height: 44px;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text-2);
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .chip:hover {
    color: var(--text);
    border-color: var(--accent-line);
  }
  .chip[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .empty {
    align-items: flex-start;
    margin-top: 1rem;
  }

  .enquiry-layout {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 980px) {
    .enquiry-layout {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
  .enquiry-layout__info {
    display: grid;
    gap: 1.25rem;
  }
  .enquiry-layout__form h3 {
    font-size: var(--fs-xl);
    margin-bottom: 0.5rem;
  }
  .contact-methods {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .contact-method {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .contact-method:hover {
    border-color: var(--accent-line);
    color: var(--text);
  }
  .contact-method small {
    display: block;
    color: var(--text-2);
  }
  .contact-method strong {
    font-size: var(--fs-lg);
  }
  .break {
    overflow-wrap: anywhere;
  }
  .steps {
    padding-left: 1.25rem;
    display: grid;
    gap: 0.5rem;
    color: var(--text-2);
  }
  .steps strong {
    color: var(--text);
  }

  .faq__list {
    display: grid;
    gap: 0.75rem;
    max-width: 52rem;
  }
  .faq__item {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 56px;
    padding: 1rem 1.25rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary :global(svg) {
    flex: none;
    color: var(--accent);
    transition: rotate 0.2s var(--ease);
  }
  .faq__item[open] summary :global(svg) {
    rotate: 180deg;
  }
  .faq__item p {
    padding: 0 1.25rem 1.25rem;
    color: var(--text-2);
  }
</style>
