---
import { Image } from 'astro:assets';

import Icon from '@/components/ui/Icon.astro';
import { MAIN_NAV, SITE, telHref } from '@/config/site';
import logo from '@/assets/brand/logo.webp';
import { cleanPath } from '@/lib/seo';

const path = cleanPath(Astro.url.pathname);
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<div class="topbar">
  <div class="container topbar__inner">
    <p><Icon name="bolt" size={14} /> {`Commercial dishwasher repair specialists across ${SITE.serviceArea}`}</p>
    <a href={telHref} class="topbar__phone"><Icon name="phone" size={14} /> {SITE.phone.display}</a>
  </div>
</div>

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <Image src={logo} alt={`${SITE.name} — home`} width={150} height={62} loading="eager" fetchpriority="high" class="brand__logo" />
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {
          MAIN_NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={telHref} class="call-btn" aria-label={`Call ${SITE.phone.display}`}>
        <Icon name="phone" size={18} />
        <span class="call-btn__text">{SITE.phone.display}</span>
      </a>
      <a href="/booking" class="btn btn--primary book-btn">Book Repair</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="sr-only" data-menu-label>Open menu</span>
        <Icon name="menu" size={24} class="menu-toggle__open" />
        <Icon name="close" size={24} class="menu-toggle__close" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" hidden data-menu>
    <nav class="container" aria-label="Mobile">
      <ul>
        <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a></li>
        {
          MAIN_NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-menu__cta">
        <a href="/booking" class="btn btn--primary btn--lg btn--block">Book a Repair</a>
        <a href={telHref} class="btn btn--secondary btn--lg btn--block"><Icon name="phone" size={20} /> Call {SITE.phone.display}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    document.body.classList.toggle('menu-open', open);
    if (label) label.textContent = open ? 'Close menu' : 'Open menu';
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 1180px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>

<style>
  .topbar {
    background: var(--accent);
    color: var(--accent-ink);
    font-size: var(--fs-xs);
    font-weight: 700;
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 36px;
  }
  .topbar p,
  .topbar a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .topbar a {
    color: inherit;
    text-decoration: none;
  }
  .topbar a:hover {
    text-decoration: underline;
    color: inherit;
  }
  @media (max-width: 560px) {
    .topbar__phone {
      display: none !important;
    }
    .topbar__inner {
      justify-content: center;
    }
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(6 10 19 / 0.86);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--border);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: var(--header-h);
  }
  .brand {
    flex: none;
    display: block;
    border-radius: 8px;
  }
  .brand__logo {
    width: 132px;
    height: auto;
  }

  .nav {
    display: none;
    margin-inline: auto;
  }
  .nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 0.15rem;
  }
  .nav a {
    display: block;
    padding: 0.5rem 0.65rem;
    border-radius: 6px;
    color: var(--text-2);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .nav a[aria-current='page'] {
    color: var(--accent);
  }

  .site-header__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .call-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 48px;
    min-height: 48px;
    padding-inline: 0.75rem;
    color: var(--text);
    font-weight: 700;
    font-size: var(--fs-sm);
    text-decoration: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
  }
  .call-btn:hover {
    color: var(--accent);
    border-color: var(--accent-line);
  }
  .call-btn__text {
    display: none;
  }
  .book-btn {
    display: none;
  }
  .menu-toggle {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    background: var(--surface-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
  }
  .menu-toggle :global(.menu-toggle__close),
  .menu-toggle[aria-expanded='true'] :global(.menu-toggle__open) {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] :global(.menu-toggle__close) {
    display: block;
  }

  .mobile-menu {
    border-top: 1px solid var(--border);
    background: var(--bg);
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    padding-block: 0.5rem 1.5rem;
  }
  .mobile-menu ul {
    list-style: none;
    padding: 0;
  }
  .mobile-menu li a {
    display: block;
    padding: 0.95rem 0.25rem;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }
  .mobile-menu li a[aria-current='page'] {
    color: var(--accent);
  }
  .mobile-menu__cta {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 640px) {
    .book-btn {
      display: inline-flex;
    }
    .brand__logo {
      width: 150px;
    }
  }
  @media (min-width: 1180px) {
    .nav {
      display: block;
    }
    .menu-toggle,
    .mobile-menu {
      display: none;
    }
  }

  :global(body.menu-open) {
    overflow: hidden;
  }
  @media (min-width: 1180px) {
    :global(body.menu-open) {
      overflow: auto;
    }
  }
</style>
