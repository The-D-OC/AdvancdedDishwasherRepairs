---
import Icon from '@/components/ui/Icon.astro';
import { telHref } from '@/config/site';
---

<div class="call-bar" role="region" aria-label="Quick contact">
  <a href={telHref} class="btn btn--primary"><Icon name="phone" size={18} /> Call now</a>
  <a href="/booking" class="btn btn--secondary"><Icon name="calendar" size={18} /> Book repair</a>
</div>

<style>
  .call-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding: 0.6rem var(--gutter) calc(0.6rem + env(safe-area-inset-bottom));
    background: rgb(6 10 19 / 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--border);
  }
  /* Keep footer content clear of the fixed bar. */
  :global(body) {
    padding-bottom: calc(68px + env(safe-area-inset-bottom));
  }
  @media (min-width: 768px) {
    .call-bar {
      display: none;
    }
    :global(body) {
      padding-bottom: 0;
    }
  }
</style>
