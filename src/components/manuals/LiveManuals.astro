---
/**
 * Server island: lists manuals from Supabase on otherwise static pages
 * (home page, brand pages). Use with `server:defer`.
 */
import Icon from '@/components/ui/Icon.astro';
import { listPublicManuals } from '@/lib/manuals';
import { publicClient } from '@/lib/supabase';

interface Props {
  /** Only show this brand (case-insensitive). */
  brand?: string;
  limit?: number;
  /** Shown when there are no manuals (omit to render nothing). */
  emptyText?: string;
}

const { brand, limit = 4, emptyText } = Astro.props;
const manuals = (await listPublicManuals(publicClient()))
  .filter((m) => !brand || m.brand.toLowerCase() === brand.toLowerCase())
  .sort((a, b) => b.updatedAt.localeCompare(a.updatedAt))
  .slice(0, limit);
---

{
  manuals.length > 0 ? (
    <ul class="link-list">
      {manuals.map((m) => (
        <li>
          <a href={`/manuals/${m.slug}`}>
            <span class="code">
              <Icon name="file" size={16} />
            </span>
            <span>
              <strong>{m.title}</strong>
              <small>{[m.productType, m.pdfUrl ? 'PDF' : ''].filter(Boolean).join(' · ')}</small>
            </span>
            <Icon name="arrowRight" size={16} />
          </a>
        </li>
      ))}
    </ul>
  ) : (
    emptyText && <p class="muted">{emptyText}</p>
  )
}
