---
/**
 * Stylised illustration of a commercial dishwasher, used where no
 * photograph is available yet (e.g. machines without CMS photos).
 */
import type { MachineType } from '@/types/content';

interface Props {
  type?: MachineType;
  class?: string;
}

const { type = 'Pass-through / hood', class: className } = Astro.props;
const isHood = type === 'Pass-through / hood';
const isConveyor = type === 'Rack conveyor';
const uid = `mv-${Math.random().toString(36).slice(2, 8)}`;
---

<svg viewBox="0 0 320 240" class={className} role="img" aria-label={`Illustration of a ${type.toLowerCase()}`}>
  <defs>
    <linearGradient id={`${uid}-steel`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#3b4a63" />
      <stop offset="0.5" stop-color="#26324a" />
      <stop offset="1" stop-color="#1a2338" />
    </linearGradient>
    <linearGradient id={`${uid}-glow`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#22b8f0" stop-opacity="0.55" />
      <stop offset="1" stop-color="#22b8f0" stop-opacity="0" />
    </linearGradient>
  </defs>
  <ellipse cx="160" cy="222" rx="130" ry="10" fill="#000" opacity="0.45" />
  {
    isConveyor ? (
      <g>
        <rect x="20" y="70" width="280" height="130" rx="8" fill={`url(#${uid}-steel)`} stroke="#4b5b78" />
        <rect x="40" y="95" width="70" height="70" rx="4" fill="#0b1324" stroke="#22b8f0" stroke-opacity="0.5" />
        <rect x="125" y="95" width="70" height="70" rx="4" fill="#0b1324" stroke="#22b8f0" stroke-opacity="0.5" />
        <rect x="210" y="95" width="70" height="70" rx="4" fill="#0b1324" stroke="#22b8f0" stroke-opacity="0.5" />
        <rect x="10" y="178" width="300" height="8" rx="2" fill="#5b6b88" />
        <rect x="240" y="78" width="44" height="10" rx="2" fill="#22b8f0" />
      </g>
    ) : isHood ? (
      <g>
        <rect x="70" y="20" width="180" height="110" rx="8" fill={`url(#${uid}-steel)`} stroke="#4b5b78" />
        <rect x="88" y="38" width="144" height="74" rx="4" fill="#0b1324" stroke="#22b8f0" stroke-opacity="0.45" />
        <rect x="88" y="38" width="144" height="74" rx="4" fill={`url(#${uid}-glow)`} />
        <rect x="20" y="130" width="280" height="12" rx="3" fill="#6b7b98" />
        <rect x="80" y="142" width="160" height="62" rx="4" fill="#1a2338" stroke="#4b5b78" />
        <rect x="196" y="26" width="40" height="8" rx="2" fill="#22b8f0" />
        <rect x="150" y="6" width="20" height="16" rx="2" fill="#4b5b78" />
      </g>
    ) : (
      <g>
        <rect x="80" y="40" width="160" height="165" rx="10" fill={`url(#${uid}-steel)`} stroke="#4b5b78" />
        <rect x="80" y="40" width="160" height="34" rx="10" fill="#1a2338" stroke="#4b5b78" />
        <rect x="96" y="52" width="58" height="10" rx="2" fill="#22b8f0" />
        <circle cx="214" cy="57" r="7" fill="#0b1324" stroke="#22b8f0" />
        <rect x="96" y="88" width="128" height="100" rx="6" fill="#0b1324" stroke="#22b8f0" stroke-opacity="0.45" />
        <rect x="96" y="88" width="128" height="100" rx="6" fill={`url(#${uid}-glow)`} />
        <rect x="120" y="80" width="80" height="6" rx="3" fill="#6b7b98" />
      </g>
    )
  }
  <path d="M168 150 l-14 22 h12 l-6 20 22 -28 h-12 l8 -14z" fill="#22b8f0" opacity="0.9" />
</svg>
