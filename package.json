{
  "name": "advanced-dishwasher-repairs",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "wrangler types --include-runtime=false && astro dev",
    "build": "wrangler types --include-runtime=false && astro check && astro build",
    "preview": "wrangler types --include-runtime=false && astro preview",
    "deploy": "npm run build && wrangler deploy",
    "check": "wrangler types --include-runtime=false && astro check",
    "seo:audit": "node scripts/seo-audit.mjs",
    "cf-typegen": "wrangler types --include-runtime=false"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.4",
    "@astrojs/sitemap": "^3.7.4",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "~6.0.3",
    "wrangler": "^4.158.0"
  }
}
